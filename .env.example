# Worlds.fm — example environment variables (NAMES ONLY).
# Copy the API section into apps/api/.env and the web section into
# apps/web/.env.local. Never commit real files or secret values.

# ---------------------------------------------------------------------------
# apps/api
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Browser origin allowlist for the Next.js app (comma-separated for several).
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Identifying User-Agent sent to external metadata providers.
# MusicBrainz requires an identifying UA ("appname/version (contact)").
MEDIA_USER_AGENT=worlds-fm/0.1 (+https://worlds.fm)

# TheAudioDB v1 API key. The documented free development key is "123"
# (30 requests/minute). Replace with a premium key if one is issued.
THEAUDIODB_API_KEY=123

# Fanart.tv API key (https://fanart.tv/get-an-api-key/).
# LEAVE EMPTY to run the backend without Fanart; the adapter disables itself.
FANART_API_KEY=

# Provider strategy and reliability tuning.
MEDIA_ARTIST_PROVIDER_ORDER=theaudiodb,fanart
MEDIA_ALBUM_PROVIDER_ORDER=coverartarchive,theaudiodb
MEDIA_HTTP_TIMEOUT_MS=8000
MEDIA_HTTP_RETRIES=2
MEDIA_HTTP_RETRY_BASE_MS=300
MUSICBRAINZ_MIN_INTERVAL_MS=1100
MEDIA_CACHE_TTL_MS=86400000
MEDIA_NEGATIVE_CACHE_TTL_MS=300000
MEDIA_CACHE_MAX_ENTRIES=1000

# ---------------------------------------------------------------------------
# apps/web (.env.local) — public, non-secret configuration only
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
