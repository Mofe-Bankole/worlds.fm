# Build context hygiene for the apps/api image (context is the repository root).
# Keeps the upload small and stops secrets or local build output from entering a
# layer. The host builds the image, so this file is what the host reads.

.git
.github

# Secrets. Both the bare and recursive forms are listed because a bare `.env`
# only matches the context root, while the Dockerfile runs `COPY apps/api apps/api`
# and apps/api/.env holds real provider credentials. Later patterns win, so the
# .env.example negations come last.
.env
.env.*
**/.env
**/.env.*
!**/.env.example

**/node_modules
**/dist
**/.next
**/.turbo
**/*.tsbuildinfo

# Documentation and local tooling are not needed to build or run the API.
docs
supabase
*.md

*.log
coverage
.DS_Store
